# Local review setup. Credentials stay server-side and untracked.
HOST=127.0.0.1
PORT=8098
LLM_PROVIDER=ollama
CASUAL_LLM_PROVIDER=ollama
TASK_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CASUAL_LLM_API_KEY=
TASK_LLM_API_KEY=
SETTINGS_API_TOKEN=
SECURITY_SECRET_KEY=
ENABLE_VISION=false
VISION_PROVIDER=ollama
VISION_BASE_URL=
VISION_MODEL=
# edge-tts requires network. GPT-SoVITS is an optional separate installation.
TTS_PROVIDER=edge-tts
TTS_VOICE=ko-KR-SunHiNeural
GPT_SOVITS_URL=http://127.0.0.1:9881/tts
GPT_SOVITS_REFERENCE_AUDIO_PATH=
GPT_SOVITS_REFERENCE_METADATA_PATH=
GPT_SOVITS_PROMPT_TEXT=
ENABLE_STT=false
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
ENABLE_OBSIDIAN_SYNC=false
ENABLE_LONG_TERM_MEMORY=false
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
COUCHDB_DB_NAME=demo_notes
ENABLE_MEMORY_CAPSULE=false
ENABLE_HACKATHON_TUTORIAL=false
TUTORIAL_DB_PATH=tutorial.sqlite
TUTORIAL_HMAC_SECRET=
TUTORIAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
TUTORIAL_OLLAMA_MODEL=
ENABLE_GOOGLE_DEMO=false
GOOGLE_DEMO_CLIENT_ID=
GOOGLE_DEMO_CLIENT_SECRET=
GOOGLE_DEMO_REFRESH_TOKEN=
GOOGLE_DEMO_CALENDAR_ID=primary
GOOGLE_DEMO_TASK_LIST_ID=@default
GOOGLE_DEMO_RECEIPTS_PATH=google_demo_receipts.json
ENABLE_DISCORD=false
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=[]
ENABLE_PROACTIVE=false
ENABLE_ACTION_ROUTER=false
ENABLE_AUTO_FINETUNE=false
