# Kirian Brain
HOST=0.0.0.0
PORT=8098

# LLM: 일상/RAG는 Ollama, 고난도 작업은 Gemini 또는 Claude
LLM_PROVIDER=ollama
CASUAL_LLM_PROVIDER=ollama
CASUAL_LLM_MODEL=
CASUAL_LLM_BASE_URL=
CASUAL_LLM_API_KEY=
TASK_LLM_PROVIDER=gemini
TASK_LLM_MODEL=
TASK_LLM_BASE_URL=
TASK_LLM_API_KEY=
LLM_PROFILES_PATH=llm_profiles.json
# 첫 실행 LLM 설정 API 전용 토큰. 비어 있으면 설정 API는 503으로 비활성화됨
SETTINGS_API_TOKEN=
OLLAMA_BASE_URL=http://<lan-host>:11434
LOCAL_LLM_MODEL=qwen2.5:7b
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# 화면 이미지는 일반 task provider와 분리한다. 기본은 비활성이고,
# 켤 때는 loopback/사설망 Ollama endpoint와 vision model을 명시해야 한다.
# 실패 시 Gemini/OpenAI/Claude로 fallback하지 않는다.
ENABLE_VISION=false
VISION_PROVIDER=ollama
VISION_BASE_URL=
VISION_MODEL=

# TTS: 키리안 V2Pro는 CPUFast CPU 추론, 장애 시 Brain이 edge-tts로 폴백
TTS_PROVIDER=gpt-sovits-cpufast
FISH_SPEECH_URL=http://<lan-host>:8080/v1/tts
FISH_SPEECH_REFERENCE_ID=tanya
FISH_SPEECH_TIMEOUT_SECONDS=30
AIVIS_SPEECH_URL=http://127.0.0.1:10101
# 코하쿠 ねむたい. 다른 모델·스타일로 교체할 때 ID만 변경한다.
AIVIS_SPEECH_STYLE_ID=1878365379
AIVIS_SPEECH_TIMEOUT_SECONDS=30
GPT_SOVITS_URL=http://127.0.0.1:9881/tts
GPT_SOVITS_REFERENCE_AUDIO_PATH=/home/kirian/tts/gpt-sovits-cpufast/ref_audio/ref_affection.wav
GPT_SOVITS_PROMPT_TEXT=자기야, 오늘도 진짜 수고 많았어. 푹 쉬어.
GPT_SOVITS_TIMEOUT_SECONDS=45
GPT_SOVITS_SEED=12345
GPT_SOVITS_REFERENCE_METADATA_PATH=/home/kirian/tts/gpt-sovits-cpufast/ref_audio/ref_audio_meta.json
# 비우면 화면 문장을 그대로 읽고, ja면 TTS용 일본어로 번역한다.
TTS_TARGET_LANGUAGE=
TTS_VOICE=ko-KR-SunHiNeural

# Obsidian LiveSync / RAG
ENABLE_OBSIDIAN_SYNC=False
COUCHDB_URL=http://<lan-host>:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
COUCHDB_DB_NAME=obsidian_sync_db
ENABLE_LONG_TERM_MEMORY=False
MEMORY_DB_PATH=kirian_memory.db

# 공개 웹 기억 캡슐 — 개인 Obsidian DB와 별도 CouchDB/SQLite를 사용한다.
ENABLE_MEMORY_CAPSULE=false
MEMORY_CAPSULE_INDEX_DB_PATH=kirian_public_memory_capsules.db
MEMORY_CAPSULE_COUCHDB_URL=http://127.0.0.1:5984
MEMORY_CAPSULE_COUCHDB_USER=
MEMORY_CAPSULE_COUCHDB_PASSWORD=
MEMORY_CAPSULE_COUCHDB_DB_NAME=kirian_public_memory_capsules
MEMORY_CAPSULE_TTL_SECONDS=1800
MEMORY_CAPSULE_APPROVAL_TTL_SECONDS=120
MEMORY_CAPSULE_SYNC_INTERVAL_SECONDS=5
MEMORY_CAPSULE_TIMEOUT_SECONDS=5
MEMORY_CAPSULE_RATE_LIMIT_PER_ACTION=10

# 공개 해커톤 통합 튜토리얼 — 개인 기억·T-025 캡슐과 다른 SQLite를 사용한다.
# HMAC secret은 UTF-8 32 bytes 이상의 무작위 값으로 운영 VM의 비추적 .env에만 둔다.
ENABLE_HACKATHON_TUTORIAL=false
TUTORIAL_DB_PATH=/home/kirian/data/brain/tutorial.sqlite
TUTORIAL_HMAC_SECRET=
TUTORIAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
TUTORIAL_OLLAMA_MODEL=
TUTORIAL_OLLAMA_TIMEOUT_SECONDS=60
TUTORIAL_CLEANUP_POLL_SECONDS=30

# Discord
ENABLE_DISCORD=False
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=[]

# Personalization / fine-tuning
ENABLE_FINETUNE_SCORING=False
ENABLE_AUTO_FINETUNE=False
FINETUNE_TRIGGER_COUNT=500
FINETUNE_SCHEDULE_HOUR=2
FINETUNE_OUTPUT_DIR=finetune_data

# Optional features
ENABLE_PERSONA=True
ENABLE_MEMORY=True
ENABLE_EMOTION=True
ENABLE_ACTION_ROUTER=False
ENABLE_SECURITY=False
ENABLE_PROACTIVE=False

# Security: 반드시 운영 환경에서 교체
SECURITY_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=[]

# ── 공개 배포용 요청 제한 (T-017) ──
# 내부망·데스크톱 사용에는 필요 없다. 웹 체험판을 인터넷에 노출할 때만 켠다.
# 켜기 전에 반드시 NPM에서 CF-Connecting-IP를 복원해야 한다.
# 그러지 않으면 모든 방문자가 같은 IP로 보여 한 명이 전체 한도를 소진한다.
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_DAILY_TOTAL=2000
RATE_LIMIT_MAX_CONNECTIONS=3
RATE_LIMIT_STT_PER_MINUTE=5

# ── 웹 체험판 Google 데모 계정 ──
# 개인 계정이 아니라 심사용 데모 계정의 OAuth 값만 서버 .env에 넣는다.
# 세 값이 모두 있고 ENABLE_GOOGLE_DEMO=true일 때만 웹 쓰기 실행이 활성화된다.
ENABLE_GOOGLE_DEMO=false
GOOGLE_DEMO_CLIENT_ID=
GOOGLE_DEMO_CLIENT_SECRET=
GOOGLE_DEMO_REFRESH_TOKEN=
GOOGLE_DEMO_CALENDAR_ID=primary
GOOGLE_DEMO_TASK_LIST_ID=@default
GOOGLE_DEMO_RECEIPTS_PATH=/home/kirian/data/brain/google_demo_receipts.json
GOOGLE_DEMO_TIMEOUT_SECONDS=10
