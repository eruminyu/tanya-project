# Google Cloud Console에서 생성한 Desktop OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 기본 Brain 주소를 빌드에 고정하고 싶을 때만 설정한다.
# 비워두면 http://localhost:8098 을 쓰고, 설정 화면에서 언제든 바꿀 수 있다.
# 주의: 여기 적은 주소는 tauri.conf.json 의 connect-src 에도 있어야 웹뷰가 연결을 허용한다.
#VITE_BRAIN_URL=http://<lan-host>:8098
