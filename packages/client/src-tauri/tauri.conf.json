{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "타냐",
  "version": "0.1.0",
  "identifier": "dev.tanya.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "타냐",
        "width": 440,
        "height": 640,
        "minWidth": 360,
        "minHeight": 520,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
