{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../client/vendor/cubism-framework/live2dcubismcore.d.ts"
  ]
}
