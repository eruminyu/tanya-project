{
  "name": "@kirian/web-gateway",
  "version": "0.1.0",
  "description": "Public demo gateway: static web, visitor sessions and a restricted proxy to a public_demo Brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm --prefix ../contracts run build && tsc -p tsconfig.json",
    "start": "node dist/web-gateway/src/main.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "authorize": "node dist/web-gateway/src/authorize.js"
  },
  "dependencies": {
    "@kirian/contracts": "file:../contracts",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9.2"
  }
}
