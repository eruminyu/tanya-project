# 기본: 텍스트 파일은 LF
* text=auto eol=lf

# 셸 스크립트는 반드시 LF (Windows에서 체크아웃해도 LF 유지)
*.sh text eol=lf

# Windows 전용 파일은 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.woff binary
*.woff2 binary
