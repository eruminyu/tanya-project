# /home/kirian/kirian-web/gateway.env (mode 0600, owner kirian)
KIRIAN_GATEWAY_HOST=0.0.0.0
KIRIAN_GATEWAY_PORT=8090
KIRIAN_GATEWAY_BRAIN_URL=http://127.0.0.1:8099
KIRIAN_GATEWAY_BRAIN_TOKEN_FILE=/home/kirian/kirian-web/brain-token
KIRIAN_GATEWAY_STATIC_DIR=/home/kirian/kirian-web/current/web
# The public domain is proxied by Cloudflare: take the visitor address from cf-connecting-ip.
KIRIAN_GATEWAY_TRUST_PROXY=1
KIRIAN_GATEWAY_CONCURRENT_TURNS=2
KIRIAN_GATEWAY_TURNS_PER_SESSION=30
KIRIAN_GATEWAY_SESSIONS_PER_HOUR=20

# Calendar execution. 'handoff' (default) prepares a Google Calendar link + .ics for the visitor's own calendar.
# 'google_demo' writes approved drafts to a dedicated PUBLIC demo calendar of the demo account and sweeps them.
KIRIAN_GATEWAY_EXECUTOR=handoff
KIRIAN_GATEWAY_CALENDAR_LABEL=내 캘린더
KIRIAN_GATEWAY_CALENDAR_TIMEZONE=Asia/Seoul
#KIRIAN_GATEWAY_EXECUTOR=google_demo
#KIRIAN_GATEWAY_GOOGLE_DEMO_CREDENTIAL_FILE=/home/kirian/kirian-web/google-demo-credential.json
#KIRIAN_GATEWAY_GOOGLE_DEMO_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
#KIRIAN_GATEWAY_GOOGLE_DEMO_CLEANUP_MINUTES=60
# Minutes before an approved event's start at which the visitor gets a proactive card (default 30).
KIRIAN_GATEWAY_PROACTIVE_LEAD_MINUTES=30
