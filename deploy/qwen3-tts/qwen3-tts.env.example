# /home/kirian/tts/qwen3-tts/qwen3-tts.env (mode 0600, owner kirian)
# 0.6B is the server default: on the 8 GB RTX 3070 Ti the 1.7B model (about 4.2 GB peak measured on a PC)
# cannot stay resident next to Gemma (3.7 GB) and STT (1.1 GB). Switch to the 1.7B id only after measuring
# free VRAM on the server itself (deploy/qwen3-tts/README.md).
# install.sh rewrites this to the local snapshot path (offline unit); a repo id here needs Hub access at start.
KIRIAN_QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
KIRIAN_QWEN3_TTS_DEVICE=cuda:0
KIRIAN_QWEN3_TTS_DTYPE=bfloat16
KIRIAN_QWEN3_TTS_SPEAKERS=Sohee
KIRIAN_QWEN3_TTS_HOST=127.0.0.1
KIRIAN_QWEN3_TTS_PORT=19882
