[Unit]
Description=Kirian Brain FastAPI service
Wants=network-online.target kirian-gpt-sovits-cpufast.service
After=network-online.target kirian-gpt-sovits-cpufast.service

[Service]
Type=simple
User=kirian
Group=kirian
WorkingDirectory=/home/kirian/brain
EnvironmentFile=/home/kirian/brain/.env
Environment=PYTHONPATH=/home/kirian/brain/packages/brain
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/home/kirian/data/brain/huggingface
# faster-whisper(ctranslate2)가 GPU를 쓰려면 CUDA 런타임이 로더 경로에 있어야 한다.
# venv의 nvidia-* 패키지가 제공하며, 이 줄이 없으면 libcublas.so.12를 못 찾아
# STT가 조용히 CPU로만 동작한다.
Environment=LD_LIBRARY_PATH=/home/kirian/brain/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/home/kirian/brain/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/home/kirian/brain/.venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib
ExecStart=/home/kirian/brain/.venv/bin/python -m uvicorn main:app --app-dir /home/kirian/brain/packages/brain --host 0.0.0.0 --port 8098
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/home/kirian/data/brain

[Install]
WantedBy=multi-user.target
